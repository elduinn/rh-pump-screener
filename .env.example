# rh-pump-screener credentials — this project only.
# Self-contained on purpose: nothing here reads from /root/unicrit or
# /root/meridian-ev01 any more, so changes there cannot break this bot.
#
# Values were copied from those projects on 2026-08-18. The Telegram bot is
# still SHARED with unicrit/unicrit-v2 — swap in a token from @BotFather if you
# want --listen to stop competing with them for getUpdates.

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_IDS=

# ── LLM (OpenAI-compatible endpoint) ──────────────────────────────────────
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
